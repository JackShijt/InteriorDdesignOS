{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interiordesignos.local/schemas/design/design_spec.schema.json",
  "title": "DesignSpec",
  "description": "设计方案说明（WORKFLOW.md Stage 3，介于 Input Analysis 与 LayoutModel 之间）。是 Design Agent 的唯一设计决策输出，也是下游 LayoutModel 的唯一依据（SSOT），须先于布局生成。禁止包含 CAD / Geometry / Drawing / Layer / Entity / DWG 信息（Phase 4 §1、§17）。",
  "type": "object",
  "required": [
    "metadata", "version", "design_goal", "style", "budget", "family",
    "rooms", "constraints", "preferences", "materials", "lighting",
    "storage", "special_requirements"
  ],
  "properties": {
    "metadata": {
      "$ref": "../core/metadata.schema.json",
      "description": "统一元数据（canonical: core/metadata.schema.json，PROJECT_RULES §4.3）"
    },
    "version": {
      "type": "string",
      "description": "DesignSpec 版本，如 v1"
    },
    "design_goal": {
      "type": "string",
      "description": "总体设计目标（用户诉求 + 空间约束的凝练）"
    },
    "style": {
      "type": "object",
      "required": ["labels"],
      "description": "整体风格定义（§5，允许多个标签）",
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["Modern", "Minimal", "Nordic", "Japanese", "Industrial", "Chinese", "Luxury", "Mixed"]
          },
          "description": "风格标签（§5）：Modern/Minimal/Nordic/Japanese/Industrial/Chinese/Luxury/Mixed，允许多个"
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["level"],
      "description": "预算等级与分配建议（§6）",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "PREMIUM"]
        },
        "currency": { "type": "string", "description": "币种，默认 CNY" },
        "total_estimate": {
          "type": "number",
          "minimum": 0,
          "description": "总预算估算（元）"
        },
        "allocation": {
          "type": "array",
          "description": "预算分配建议（按类别占比）",
          "items": {
            "type": "object",
            "required": ["category", "ratio"],
            "properties": {
              "category": { "type": "string" },
              "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "required": ["adults", "children", "elders", "pets", "work_from_home", "accessibility"],
      "description": "家庭画像（§7）",
      "properties": {
        "adults": { "type": "integer", "minimum": 0 },
        "children": { "type": "integer", "minimum": 0 },
        "elders": { "type": "integer", "minimum": 0 },
        "pets": { "type": "array", "items": { "type": "string" } },
        "work_from_home": { "type": "boolean" },
        "accessibility": { "type": "boolean", "description": "是否有无障碍需求" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rooms": {
      "type": "array",
      "description": "各房间功能定位（源自 OriginalModel.rooms）",
      "items": {
        "type": "object",
        "required": ["room_id", "function"],
        "properties": {
          "room_id": { "type": "string" },
          "name": { "type": "string" },
          "function": { "type": "string", "description": "功能描述，如 会客/用餐/主卧" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "description": "空间刚性约束（§4，源自 OriginalModel 提取）",
      "properties": {
        "non_removable_walls": { "type": "array", "items": { "type": "string" }, "description": "不可拆墙" },
        "load_bearing_walls": { "type": "array", "items": { "type": "string" }, "description": "承重墙" },
        "pipe_shafts": { "type": "array", "items": { "type": "string" }, "description": "管井" },
        "windows": { "type": "array", "items": { "type": "string" }, "description": "窗户" },
        "beams": { "type": "array", "items": { "type": "string" }, "description": "梁" },
        "columns": { "type": "array", "items": { "type": "string" }, "description": "柱" },
        "balconies": { "type": "array", "items": { "type": "string" }, "description": "阳台" },
        "equipment_platforms": { "type": "array", "items": { "type": "string" }, "description": "设备平台" },
        "ceiling_height_mm": { "type": "number", "minimum": 0, "description": "层高（mm）" },
        "area_m2": { "type": "number", "minimum": 0, "description": "套内面积（m2）" },
        "orientation": { "type": "string", "description": "主朝向" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "description": "用户偏好（颜色 / 采光 / 无障碍等）",
      "properties": {
        "colors": { "type": "array", "items": { "type": "string" } },
        "lighting_preference": {
          "type": "string",
          "enum": ["natural", "warm", "bright", "soft", "neutral"]
        },
        "accessibility": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "materials": {
      "type": "array",
      "description": "材料偏好（§8，禁止品牌推荐）",
      "items": {
        "type": "object",
        "required": ["category", "spec"],
        "properties": {
          "category": { "type": "string", "description": "材料类别，如 地面/墙面/顶面" },
          "spec": { "type": "string", "description": "规格说明（如 木地板/瓷砖/岩板/乳胶漆/艺术漆）" },
          "brand_recommended": {
            "type": "boolean",
            "description": "禁止品牌推荐（§8），必须为 false 或省略"
          }
        },
        "additionalProperties": false
      }
    },
    "lighting": {
      "type": "object",
      "description": "照明策略",
      "properties": {
        "natural_light": { "type": "string" },
        "artificial_light": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "description": "收纳策略",
      "properties": {
        "strategy": { "type": "string" },
        "capacity_notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "special_requirements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "特殊需求，如 健身/办公/宠物/老人照护"
    }
  },
  "additionalProperties": false
}
