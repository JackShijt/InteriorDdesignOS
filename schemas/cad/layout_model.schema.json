{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interiordesignos.local/schemas/cad/layout_model.schema.json",
  "title": "LayoutModel",
  "description": "系统唯一可信空间模型（SSOT，PROJECT_RULES §22、architecture.md §8）。仅描述空间事实，禁止包含任何 CAD 图层/图元/绘图命令（见下方 not 约束）。墙体/门/窗属于空间事实，由 LayoutModel 负责。下游 Agent 必须基于本模型工作，不得重新解释需求或自改设计。",
  "type": "object",
  "required": ["metadata", "version", "rooms", "furniture", "constraints", "walls", "doors", "windows"],
  "properties": {
    "metadata": {
      "$ref": "../core/metadata.schema.json",
      "description": "统一元数据（canonical: core/metadata.schema.json，PROJECT_RULES §4.3）"
    },
    "version": {
      "type": "object",
      "required": ["model_version", "parent_version", "approval_status"],
      "description": "LayoutModel 版本链元数据（architecture.md §8 LayoutModel Version Chain）",
      "properties": {
        "model_version": { "type": "string", "description": "当前版本，如 v1/v2/v3" },
        "parent_version": { "type": "string", "description": "父版本，首版为 none" },
        "change_reason": { "type": "string" },
        "changed_by": { "type": "string" },
        "approval_status": {
          "type": "string",
          "enum": ["DRAFT", "PENDING", "APPROVED", "REJECTED"],
          "description": "须经 Human Approval（PROJECT_RULES §17）后方为 APPROVED"
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "rooms": {
      "type": "array",
      "description": "房间布局（空间定义，canonical: room/room.schema.json）",
      "items": { "$ref": "../room/room.schema.json" }
    },
    "furniture": {
      "type": "array",
      "description": "家具布置（空间定位，非 CAD 图元）",
      "items": {
        "type": "object",
        "required": ["id", "category", "position", "rotation"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string", "description": "家具类别，如 SOFA/BED/WARDROBE" },
          "position": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 },
          "rotation": { "type": "number", "description": "旋转角（°）" },
          "size": {
            "type": "object",
            "properties": {
              "width": { "type": "number", "minimum": 0 },
              "depth": { "type": "number", "minimum": 0 },
              "height": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "description": "空间约束",
      "items": {
        "type": "object",
        "properties": {
          "fixed_wall": { "type": "string", "description": "不可移动墙体引用" },
          "forbidden_area": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" } }
          },
          "requirement": { "type": "string", "description": "设计约束说明" }
        }
      }
    },
    "walls": {
      "type": "array",
      "description": "墙体空间事实（非 CAD 图元）",
      "items": {
        "type": "object",
        "required": ["id", "start", "end"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 },
          "end": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 },
          "thickness": { "type": "number", "minimum": 0 },
          "type": { "type": "string", "enum": ["BEARING", "PARTITION", "CURTAIN"] }
        }
      }
    },
    "doors": {
      "type": "array",
      "description": "门空间事实（非 CAD 图元）",
      "items": {
        "type": "object",
        "required": ["id", "position", "width"],
        "properties": {
          "id": { "type": "string" },
          "position": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 },
          "width": { "type": "number", "minimum": 0 },
          "swing": { "type": "string", "enum": ["IN", "OUT", "SLIDING", "FOLD"] }
        }
      }
    },
    "windows": {
      "type": "array",
      "description": "窗空间事实（非 CAD 图元）",
      "items": {
        "type": "object",
        "required": ["id", "position", "width"],
        "properties": {
          "id": { "type": "string" },
          "position": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 3 },
          "width": { "type": "number", "minimum": 0 },
          "sill_height": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    { "not": { "required": ["cad_layer"] }, "description": "禁止包含 CAD 图层" },
    { "not": { "required": ["dwg_entity"] }, "description": "禁止包含 DWG 图元" },
    { "not": { "required": ["drawing_command"] }, "description": "禁止包含绘图命令" }
  ],
  "additionalProperties": false
}
